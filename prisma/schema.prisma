// Схема бази. Зміни → `npm run db:migrate -- --name <що змінилось>`:
// Prisma створить міграцію в prisma/migrations (вона йде в git) і оновить клієнт.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

/// Автор статей (пастор, служитель). Окремо — щоб не вписувати щоразу.
model Author {
  id        String    @id @default(cuid())
  name      String
  role      String
  /// Адреса фото (/uploads/...). На етапі 5 — звʼязок із медіатекою.
  photo     String
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id             String         @id @default(cuid())
  /// Частина адреси: /blog/<slug>
  slug           String         @unique
  title          String
  status         ArticleStatus  @default(DRAFT)
  /// Дата, яку бачать читачі; задається при публікації
  publishedAt    DateTime?
  tags           String[]
  coverSrc       String
  coverAlt       String         @default("")
  /// Масив блоків статті. Структуру кожного блоку перевіряє zod
  /// (src/features/blog/types.ts) — і при збереженні, і при читанні.
  blocks         Json           @default("[]")
  /// Якщо порожні — беруться назва і перший абзац
  seoTitle       String?
  seoDescription String?
  author         Author         @relation(fields: [authorId], references: [id])
  authorId       String
  /// Хто створив / хто останнім змінив (адміни; не плутати з автором статті)
  createdBy      User?          @relation("ArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?
  updatedBy      User?          @relation("ArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById    String?
  events         ArticleEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([updatedAt])
}

enum ArticleAction {
  CREATED
  EDITED
  PUBLISHED
  UNPUBLISHED
}

/// Журнал змін статті: хто і що робив. Послідовні правки однієї людини
/// (автозбереження) зливаються в один запис «редагував» — див. server/admin/history.ts
model ArticleEvent {
  id        String        @id @default(cuid())
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    ArticleAction
  /// Час останньої дії (для злитих правок — оновлюється)
  at        DateTime      @default(now())

  @@index([articleId, at])
}

// ---------- Адмінка: користувачі й вхід ----------

enum UserRole {
  /// Усе, включно з користувачами
  ADMIN
  /// Статті й медіа
  EDITOR
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  /// argon2id — сам пароль ніде не зберігається
  passwordHash    String
  role            UserRole       @default(EDITOR)
  /// Фото в адмінці (адреса з медіатеки, /uploads/…-1600.webp)
  avatar          String?
  lastLoginAt     DateTime?
  sessions        Session[]
  media           Media[]
  articlesCreated Article[]      @relation("ArticleCreatedBy")
  articlesUpdated Article[]      @relation("ArticleUpdatedBy")
  articleEvents   ArticleEvent[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

/// Вхід = сесія. У cookie — випадковий токен, тут — лише його SHA-256:
/// навіть якщо базу вкрадуть, увійти чужими сесіями не вийде.
model Session {
  /// SHA-256 від токена з cookie
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Невдалі спроби входу — для обмеження перебору паролів
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ---------- Медіатека ----------

/// Завантажене фото. На диску — кілька розмірів webp:
/// <UPLOADS_DIR>/<path>-<ширина>.webp (див. src/features/media/urls.ts)
model Media {
  id           String   @id @default(cuid())
  /// Без розміру й розширення: «2026/11/cm…»
  path         String   @unique
  originalName String
  /// Розміри після повороту, до зменшення
  width        Int
  height       Int
  /// Вага найбільшого варіанта, байти
  bytes        Int
  /// Опис для незрячих і пошуку — підставляється, коли фото вибирають
  alt          String   @default("")
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
